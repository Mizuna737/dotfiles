# mako notification daemon config (Rubix session)
#
# Colours come from rubix, derived from the current wallpaper; rubixTheme.py
# regenerates the included file on every change and runs `makoctl reload`.
# Everything here is layout and behaviour only.
font=sans 11
border-size=2
border-radius=8
padding=12
margin=10
default-timeout=6000
anchor=top-right
max-visible=5

include=~/.cache/rubix/mako-theme.conf

[urgency=critical]
default-timeout=0

# teams-for-notif runs headless: workAssistant's notifWatcher reads its
# notifications straight off D-Bus, so nothing needs to appear on screen.
# The notification is still delivered — it just never draws.
[app-name=teams-for-notif]
invisible=1
