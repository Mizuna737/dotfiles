/* Rounded launcher theme. Layout lives in rubixRoundedCommon.rasi; the
   palette is generated from the current wallpaper by ~/Scripts/rubixTheme.py.
   Originally rounded-nord-dark by Newman Sanchez (https://github.com/newmanls),
   which no longer has anything Nordic left in it. */

/* Fallback palette, so the launcher still opens on a machine where
   rubixTheme.py has not run yet. The @import below overrides all of it --
   later definitions win -- so these values are only ever seen once. */
* {
    bg0:    #17212ae6;
    bg1:    #2b3843;
    bg2:    #b7c6d5e6;
    bg3:    #9bc9f4;
    fg0:    #cfdfef;
    fg1:    #cfdfef;
    fg2:    #cfdfef;
    fg3:    #b7c6d5;
}

@import "/home/max/.cache/rubix/rofi-colors.rasi"
@import "rubixRoundedCommon.rasi"

element selected {
    text-color: @bg1;
}

/* The panel is translucent over a live wallpaper, so without an edge it has
   no silhouette -- this is the same accent ring the focused window border
   gets. */
window {
    border:         2px;
    border-color:   @bg3;
}
