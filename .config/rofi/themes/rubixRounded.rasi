/* Rounded launcher theme. Palette block is generated by ~/Scripts/rubixTheme.py
   from the wallpaper; everything below the @import is hand-written.
   Layout lives in rubixRoundedCommon.rasi.
   Originally rounded-nord-dark by Newman Sanchez (https://github.com/newmanls),
   which no longer has anything Nordic left in it. */

* {
    bg0:    #2b1e0ae6;
    bg1:    #44341c;
    bg2:    #cbb89be6;
    bg3:    #e9b060;
    fg0:    #e6d1b2;
    fg1:    #e6d1b2;
    fg2:    #e6d1b2;
    fg3:    #cbb89b;
}


@import "rubixRoundedCommon.rasi"

element selected {
    text-color: @bg1;
}

/* Hand-written, kept below the generated palette block so rubixTheme.py
   leaves it alone. The panel is translucent over a live wallpaper, so
   without an edge it has no silhouette -- this is the same accent ring the
   focused window border gets. */
window {
    border:         2px;
    border-color:   @bg3;
}
