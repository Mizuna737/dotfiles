[Unit]
Description=Gesture control action daemon — D-Bus signals to commands
PartOf=rubix-session.target
After=rubix-session.target gestureControl.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# DISPLAY comes from the session env (XWayland), so xdotool-based bindings keep
# reaching X11 clients without pinning the engine to an X11 session.
ExecStart=%h/.local/share/gesturecontrol/venv/bin/python3 %h/gesturecontrol/gestureControl-actions.py
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.cache/gesturecontrol-actions.log
StandardError=append:%h/.cache/gesturecontrol-actions.log

[Install]
WantedBy=rubix-session.target
