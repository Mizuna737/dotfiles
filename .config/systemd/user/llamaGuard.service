[Unit]
Description=llamaServer resource guard (stops on high RAM/VRAM or fullscreen, restarts when clear)
After=graphical-session.target
OnFailure=notifyFailure@%n.service

[Service]
Type=simple
ExecStart=/home/max/Scripts/llamaGuard.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
