[Unit]
Description=Waybar tray-only stopgap on the strip (Rubix session)
PartOf=rubix-session.target
After=rubix-session.target

[Service]
Type=simple
# Same composed stylesheet as the full waybar; see waybar.service.
ExecStartPre=-/usr/bin/python3 %h/Scripts/rubixTheme.py --only waybar
ExecStart=/usr/bin/waybar -c %h/.config/waybar/trayOnly.jsonc -s %h/.cache/rubix/waybar-style.css
Restart=on-failure
RestartSec=2

[Install]
WantedBy=rubix-session.target
