[Unit]
Description=Snapcast server (house audio streams)
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p %t/houseAudio
ExecStart=/usr/bin/snapserver -c /home/max/.config/snapserver/snapserver.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
