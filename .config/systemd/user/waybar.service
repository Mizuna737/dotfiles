[Unit]
Description=Waybar status bar (Rubix session)
Documentation=man:waybar(5)
PartOf=rubix-session.target
After=rubix-session.target

[Service]
Type=simple
# Config lives in the rubix repo's contrib/waybar (the Rubix-specific bar;
# distinct from AwesomeWM's in-process wibar). Modules resolve their own data via
# the rubix IPC socket / pactl subscribe, so no extra env beyond the session's.
#
# The stylesheet is the composed one rubixTheme.py writes: contrib/waybar/
# style.css with the wallpaper-derived colour definitions prepended, so the bar
# follows the desktop theme. Regenerated here as well as on every theme change,
# because waybar exits rather than falling back when its stylesheet is missing
# and this unit can win the race against rubix's first theme write on login.
ExecStartPre=-/usr/bin/python3 %h/Scripts/rubixTheme.py --only waybar
ExecStart=/usr/bin/waybar -c %h/Projects/rubix/contrib/waybar/config.jsonc -s %h/.cache/rubix/waybar-style.css
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=rubix-session.target
