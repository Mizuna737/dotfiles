[Unit]
Description=OpenDeck Stream Deck daemon
PartOf=rubix-session.target
After=rubix-session.target waybar.service

[Service]
# --hide starts straight to the tray; waybar hosts the status-notifier item.
ExecStart=/usr/bin/opendeck --hide
Restart=on-failure
RestartSec=5

[Install]
WantedBy=rubix-session.target
